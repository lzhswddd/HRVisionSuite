{
  "run_mode": "process",
  "nodes": [
    {
      "id": "grab_0",
      "flow": "camera",
      "source": "usb:0",
      "display_divisor": 3
    },
    {
      "id": "yolo_1",
      "flow": "algo",
      "model_path": "D:/AiProgram/yolov8n.pt",
      "conf": 0.25,
      "imgsz": 640,
      "signal_divisor": 1,
      "python_exe": "D:/AIProgram/python.exe",
      "device": "auto"
    }
  ],
  "channels": [
    {
      "id": "ch_grab_0_yolo_1",
      "from": "grab_0",
      "to": "yolo_1",
      "kind": "queue",
      "maxlen": 1,
      "overflow": "drop_oldest"
    },
    {
      "id": "ch_grab_0_origin",
      "from": "grab_0",
      "to": "ui",
      "kind": "shm",
      "slot": "origin"
    },
    {
      "id": "ch_yolo_1_res",
      "from": "yolo_1",
      "to": "ui",
      "kind": "shm",
      "slot": "res"
    }
  ],
  "panes": [
    {
      "id": "pane_yolo_1",
      "origin": "ch_grab_0_origin",
      "res": "ch_yolo_1_res",
      "node": "yolo_1"
    }
  ]
}